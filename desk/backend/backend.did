   name: text;
   projectId: nat;
   revoked: bool;
   scopes: vec text;
 };
type CustomerErasure =
 record {
   createdAt: int;
   deletedAt: int;
   projectId: nat;
   reason: text;
   ticketId: nat;
 };
type Cover =
 record {
   decidedAt: int;
   decidedBy: text;
   endAt: int;
   fromPersonId: text;
   id: nat;
   planId: nat;
   reason: text;
   requestedAt: int;
   requestedBy: text;
   shift: nat;
   startAt: int;
   state: SwapState;
   toName: text;
   toPersonId: text;
 };
type Context =
 record {
   checkedAt: int;
   items: vec Item;
   state: variant {
            denied;
            ready;
            unavailable;
          };
   total: nat;
 };
type ConfigInput =
 record {
   audience: Audience;
   description: text;
   enabled: bool;
   retentionDays: nat;
   services: vec text;
   slug: text;
   title: text;
 };
type Config =
 record {
   at: int;
   audience: Audience;
   by: text;
   description: text;
   enabled: bool;
   generation: nat;
   projectId: nat;
   retentionDays: nat;
   revision: nat;
   services: vec text;
   slug: text;
   title: text;
 };
type Case =
 record {
   desk: text;
   dueAt: opt int;
   key: text;
   person: text;
   revision: int;
   state: text;
   ticket: nat;
   url: text;
 };
type Capabilities =
 record {
   export: bool;
   prepare: bool;
   release: bool;
   review: bool;
 };
type Cancellation =
 record {
   at: int;
   by: text;
   from: int;
   reason: text;
 };
type Audit =
 record {
   action: text;
   at: int;
   by: text;
   reason: text;
   recordId: nat;
 };
type Audience =
 variant {
   public;
   workspace;
 };
type Approval =
 record {
   approver: text;
   at: int;
   decidedBy: text;
   note: text;
   state: text;
 };
type Absence =
 record {
   at: int;
   by: text;
   cancelledAt: int;
   endAt: int;
   id: nat;
   name: text;
   personId: text;
   projectId: nat;
   startAt: int;
 };
