# Static website only. Install in this domain's dedicated document root.
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  Header always set Cache-Control "public, max-age=0, must-revalidate"
</IfModule>

<FilesMatch "^(\.|_headers$|_redirects$)">
  Require all denied
</FilesMatch>

RewriteEngine On
# Canonical redirects apply only to the production host, keeping staging usable.
RewriteCond %{HTTP_HOST} ^www\.kebabstack\.dev$ [NC]
RewriteRule ^ https://kebabstack.dev%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^kebabstack\.dev$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://kebabstack.dev%{REQUEST_URI} [R=301,L,NE]
