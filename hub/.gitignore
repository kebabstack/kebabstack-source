# toolchain / build output (regenerated by mops install / mops build)
.mops/
backend/dist/

# icp CLI state — canister-id mappings stay uncommitted (house convention:
# no committed mappings for engine apps)
.icp/

# local scratch
node_modules/
.DS_Store

# NOTE committed on purpose:
#   backend/backend.did   — public interface
#   backend/backend.most  — stable-memory baseline for upgrade checks
#   mops.lock             — dependency lock
#   dist/                 — frontend served as-is (incl. agent-bundle.js)
