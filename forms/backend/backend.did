type SubView =
 record {
   answers: text;
   assignee: text;
   assigneeName: text;
   formId: nat;
   id: nat;
   notes: vec Note;
   num: nat;
   people: vec record {
                 text;
                 text;
                 text;
               };
   reviews: vec Review;
   status: SubStatus;
   submittedAt: int;
   submitterEmail: text;
   submitterName: text;
   updatedAt: int;
 };
type SubStatus =
 variant {
   accepted;
   declined;
   inReview;
   received;
 };
type Settings =
 record {
   adminCount: nat;
   adminEmails: vec text;
   adminGroup: text;
   appUrl: text;
   demoSeeded: bool;
   forms: nat;
   hubId: text;
   lastDirectoryPull: int;
   orgName: text;
   peopleCount: nat;
   submissions: nat;
   trashed: nat;
 };
type Review =
 record {
   at: int;
   rating: nat;
   reviewer: text;
 };
type PermissionStatus =
 record {
   app: text;
   directoryAt: int;
   legacy: vec LegacyGrant;
   legacyGroups: vec record {
                       name: text;
                       role: text;
                     };
   model: nat;
   revision: text;
 };
type OwnedObject =
 record {
   id: text;
   kind: text;
   meta: text;
   title: text;
   updatedAt: int;
 };
type Note =
 record {
   at: int;
   author: text;
   "text": text;
 };
type Manifest =
 record {
   description: text;
   name: text;
   needs: vec text;
   version: text;
   wants: vec text;
 };
type LogRow =
 record {
   at: int;
   what: text;
   who: text;
 };
type LegacyGrant =
 record {
   email: text;
   role: text;
   source: text;
 };
type Item =
 record {
   detail: text;
   historical: bool;
   id: text;
   kind: text;
   path: text;
   status: text;
   title: text;
 };
type FormStatus =
 variant {
   closed;
   draft;
   open;
 };
type FormMeta =
 record {
   allowEdit: bool;
   cap: nat;
   closesAt: int;
   createdAt: int;
   createdBy: text;
   createdByName: text;
   id: nat;
   myRole: text;
   slug: text;
   status: FormStatus;
   subs: nat;
   subsAccepted: nat;
   subsDeclined: nat;
   subsInReview: nat;
   subsReceived: nat;
   title: text;
   updatedAt: int;
 };
type FormFull =
 record {
   form: Form;
   meta: FormMeta;
   shares: vec record {
                 text;
                 text;
                 text;
               };
 };
type Form =
 record {
   allowEdit: bool;
   cap: nat;
   createdAt: int;
   createdBy: text;
   description: text;
   id: nat;
   nextNum: nat;
   schema: text;
   slug: text;
   status: FormStatus;
   title: text;
   updatedAt: int;
 };
type DirectoryRow =
 record {
   active: bool;
   attributes: vec record {
                     text;
                     text;
                   };
   displayName: text;
   email: text;
   externalId: text;
   firstName: text;
   id: opt text;
   lastName: text;
   source: text;
 };
type Context =
 record {
   checkedAt: int;
   items: vec Item;
   state: variant {
            denied;
            ready;
            unavailable;
          };
   total: nat;
 };
/// kebab-stack forms — forms in, decisions out.
///
/// A form builder (sections, the usual question types, go-to-section
/// branching) with anonymous public links, and a review pipeline for what
/// comes in: received → in review → accepted / declined, with ratings, an
/// assignee and team notes per submission. Charts and CSV export. Forms are
/// shared with colleagues as editors or viewers; deleted forms rest in a
/// 90-day trash.
///
/// Access model: people from the hub directory build and review (sign-in by
/// hub ticket, mo:kebab-hub). Respondents are anonymous — every form has a
/// random public slug; a client-generated edit token lets a respondent change
/// their own answers while the form allows it. Public writes are rate-limited
/// and growth-capped. The form definition and the answers are opaque JSON
/// owned by the frontend ({"v":1,…}); the canister owns identity, lifecycle,
/// review state and caps.
///
/// Stable-state rules: every top-level let/var is stable and append-only —
/// never remove or rename one; new data goes into new side tables.
service : {
  addAdminEmail: (email: text) -> (bool);
  addNote: (tok: text, subId: nat, "text": text) ->
   (record {
      detail: text;
      ok: bool;
    });
  adminLogRows: (tok: text) -> (vec LogRow) query;
  assignSubmission: (tok: text, subId: nat, email: text) ->
   (record {
      detail: text;
      ok: bool;
    });
  claimAdmin: (tok: text) -> (record {
                                detail: text;
                                ok: bool;
                              });
  createForm: (tok: text, title: text) -> (opt FormMeta);
  /// Soft delete — the form rests in the owner's trash for 90 days; its public link stops working meanwhile.
  deleteForm: (tok: text, id: nat) -> (record {
                                         detail: text;
                                         ok: bool;
                                       });
  /// Spam clean-up: the form owner removes a submission for good.
  deleteSubmission: (tok: text, subId: nat) ->
   (record {
      detail: text;
      ok: bool;
    });
  /// People picker (sharing, assignees): active directory members matching q.
  directory: (tok: text, q: text) ->
   (vec record {
          department: text;
          displayName: text;
          email: text;
        }) query;
  /// Copy a form you can see into a fresh draft you own (definition + settings; no submissions, shares or deadline).
  duplicateForm: (tok: text, id: nat) -> (opt FormMeta);
  getForm: (tok: text, id: nat) -> (opt FormFull) query;
  getSettings: (tok: text) -> (opt Settings) query;
  hub_deactivate: (emails: vec text) -> (nat);
  hub_manifest: () -> (Manifest) query;
  hub_ownedObjects: (email: text) -> (vec OwnedObject) query;
  hub_permissionStatus: () -> (PermissionStatus);
  /// The Hub brokers this read for a signed-in Desk agent. The viewer retains
  /// their ordinary app permissions; this endpoint never grants extra access.
  hub_personContext: (viewer: text, subject: text, viewerRole: text) ->
   (Context) query;
  hub_ping: () -> (text) query;
  hub_reassign: (ids: vec text, from: text, to: text) -> (nat);
  hub_upsert: (rows: vec DirectoryRow) -> (nat);
  hub_usesGroup: (_name: text) -> (vec text) query;
  info: () ->
   (record {
      appUrl: text;
      hubId: text;
      hubSet: bool;
      orgName: text;
      version: text;
    }) query;
  /// Own forms + forms shared with me.
  listForms: (tok: text) -> (vec FormMeta) query;
  listSubmissions: (tok: text, formId: nat) -> (vec SubView) query;
  listTrash: (tok: text) ->
   (vec record {
          deletedAt: int;
          id: nat;
          purgeAt: int;
          subs: nat;
          title: text;
        }) query;
  loginWithTicket: (ticket: text) ->
   (opt
     record {
       displayName: text;
       email: text;
       role: text;
       suiteToken: text;
       token: text;
     });
  /// Respondent pulls their own submission back (edit lane).
  mySubmission: (slug: text, editToken: text) ->
   (opt record {
          answers: text;
          num: nat;
          status: SubStatus;
          updatable: bool;
        }) query;
  /// Internal preview: any status incl. drafts, sign-in + access required, never creates a submission.
  previewForm: (tok: text, slug: text) ->
   (opt
     record {
       allowEdit: bool;
       closesAt: int;
       description: text;
       id: nat;
       myRole: text;
       schema: text;
       status: FormStatus;
       title: text;
     }) query;
  publicForm: (slug: text) ->
   (opt
     record {
       allowEdit: bool;
       capReached: bool;
       closesAt: int;
       description: text;
       open: bool;
       orgName: text;
       schema: text;
       title: text;
     }) query;
  /// Delete forever, straight from the trash (owner only).
  purgeForm: (tok: text, id: nat) -> (record {
                                        detail: text;
                                        ok: bool;
                                      });
  /// One rating per reviewer (upsert), 1..5.
  rateSubmission: (tok: text, subId: nat, rating: nat) ->
   (record {
      detail: text;
      ok: bool;
    });
  removeDemo: (tok: text) -> (record {
                                detail: text;
                                ok: bool;
                              });
  /// Back from the trash, exactly as it was. Shares with people who left are dropped silently.
  restoreForm: (tok: text, id: nat) -> (record {
                                          detail: text;
                                          ok: bool;
                                        });
  seedDemo: (tok: text) -> (record {
                              detail: text;
                              ok: bool;
                            });
  setAdminEmails: (tok: text, emails: vec text) ->
   (record {
      detail: text;
      ok: bool;
    });
  /// Response deadline (ns epoch, 0 = none). Owner/editor set it.
  setDeadline: (tok: text, id: nat, closesAt: int) ->
   (record {
      detail: text;
      ok: bool;
    });
  setFormStatus: (tok: text, id: nat, status: FormStatus) ->
   (record {
      detail: text;
      ok: bool;
    });
  setHub: (id: text) -> (bool);
  setSettings: (tok: text, args:
   record {
     adminGroup: text;
     appUrl: text;
     orgName: text;
   }) -> (record {
            detail: text;
            ok: bool;
          });
  /// Replaces the full share list. Roles: editor | viewer.
  setShares: (tok: text, id: nat, shares: vec record {
                                                text;
                                                text;
                                              }) ->
   (record {
      detail: text;
      ok: bool;
    });
  setSubmissionStatus: (tok: text, subId: nat, status: SubStatus) ->
   (record {
      detail: text;
      ok: bool;
    });
  signOut: (tok: text) -> ();
  submitPublic: (slug: text, name: text, email: text, answers: text,
   editToken: text) -> (record {
                          detail: text;
                          num: nat;
                          ok: bool;
                        });
  syncNow: (tok: text) -> (record {
                             detail: text;
                             ok: bool;
                           });
  updateForm: (tok: text, id: nat, args:
   record {
     allowEdit: bool;
     cap: nat;
     description: text;
     schema: text;
     title: text;
   }) -> (record {
            detail: text;
            ok: bool;
          });
  updateMySubmission: (slug: text, editToken: text, answers: text) ->
   (record {
      detail: text;
      ok: bool;
    });
  whoami: (tok: text) ->
   (opt
     record {
       displayName: text;
       email: text;
       hubId: text;
       id: text;
       needsClaim: bool;
       orgName: text;
       role: text;
       roleSource: text;
     }) query;
}
